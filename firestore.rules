rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Coleção de jogos
    match /games/{gameId} {
      // Qualquer um pode visualizar os jogos listados
      allow read: if true;
      
      // Recomendação de Produção: Restringir a escrita apenas ao backend.
      // Atualmente, como o servidor backend usa o SDK de cliente anonimamente, a regra abaixo está aberta para permitir uploads.
      // Se você migrar para o Firebase Admin SDK no backend, mude para: "allow write: if false;" (o Admin SDK ignora as regras e o cliente público não conseguirá burlar o backend).
      allow write: if true;
    }
    
    // Coleção de sites
    match /sites/{siteId} {
      // Qualquer um pode visualizar os sites listados
      allow read: if true;
      
      // Recomendação de Produção: Restringir a escrita apenas ao backend.
      allow write: if true;
    }

    // Coleção de usuários (cadastro/login de alunos)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Coleção de sessões (sessões ativas dos alunos)
    match /sessions/{sessionId} {
      allow read, write: if true;
    }
  }
}
